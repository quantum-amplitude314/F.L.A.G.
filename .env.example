# Join F.L.A.G. delivery. Required, except JOIN_FLAG_SENDER.
RESEND_API_KEY=
JOIN_FLAG_RECIPIENT=you@example.com
JOIN_FLAG_SENDER="F.L.A.G. <onboarding@resend.dev>"

# Cloudflare Turnstile. Required.
# Turnstile test keys, always pass, visible widget:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Site key that always fails, visible:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=2x00000000000000000000AB
# Site key that forces an interactive challenge:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=3x00000000000000000000FF
# Secret that always fails, so the server rejects every token:
# TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA
# Secret that answers "token already spent":
# TURNSTILE_SECRET_KEY=3x0000000000000000000000000000000AA
